{
  "private": true,
  "scripts": {
    "dev": "bash scripts/dev.sh fg",
    "build": "next build",
    "start": "next start --port \"$(bash scripts/dev.sh port)\"",
    "serve": "bash scripts/dev.sh start",
    "stop": "bash scripts/dev.sh stop",
    "restart": "bash scripts/dev.sh restart",
    "status": "bash scripts/dev.sh status",
    "logs": "bash scripts/dev.sh logs",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:fk": "node scripts/apply-sql.mjs drizzle/manual/001_profile_auth_fk.sql drizzle/manual/002_one_ad_per_slot.sql",
    "db:seed": "node scripts/seed.mjs",
    "db:setup": "npm run db:push && npm run db:fk && npm run db:seed",
    "dodo:setup": "node scripts/dodo-setup.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@neondatabase/auth": "0.5.0-beta",
    "@neondatabase/serverless": "^1.1.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^22.15.18",
    "@types/react": "19.1.4",
    "@types/react-dom": "19.1.5",
    "dodopayments": "^2.49.0",
    "dotenv": "^16.5.0",
    "drizzle-kit": "^0.31.1",
    "drizzle-orm": "^0.43.1",
    "next": "15.6.0-canary.59",
    "postcss": "^8.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "standardwebhooks": "^1.1.1",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.8.3",
    "zod": "^3.24.4"
  },
  "name": "sponsor-me",
  "devDependencies": {
    "@opennextjs/cloudflare": "~1.15.1",
    "wrangler": "^4.129.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}