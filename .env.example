# ─────────────────────────────────────────────────────────────────────────────
# sponsor.imswarnil.com — environment template. Copy to `.env` and fill in.
# ─────────────────────────────────────────────────────────────────────────────

# ── Dodo Payments (real money, replacing points — TODO.md) ───────────────────
# Test mode key first. Set _LIVE alongside it when ready to charge real cards —
# lib/dodo.ts prefers _LIVE automatically, nothing else needs to change.
DODO_PAYMENTS_KEY_TEST_MODE=<test-mode-api-key>
DODO_PAYMENTS_KEY_LIVE=
# Run `npm run dodo:setup` once per key above, then set the id it prints here.
DODO_PRODUCT_ID=<pdt_...>
# From the Dodo dashboard's webhook settings — verifies incoming webhooks are
# actually from Dodo (lib/dodo.ts verifyDodoWebhook). Required to accept payments.
DODO_PAYMENTS_WEBHOOK_KEY=<whsec_...>

# ── Ghost (optional — blog stats on /placements and /studio/channels) ────────
# Leave unset and those sections just show "not connected" instead of numbers.
GHOST_API_URL=https://your-site.com
GHOST_ADMIN_API_KEY=<key-id>:<key-secret>
# Tier name that counts as a paid membership on the sponsor wall. Defaults to
# "Sponsor" if unset.
GHOST_SPONSOR_TIER=Sponsor

# ── Neon: database ───────────────────────────────────────────────────────────
# Pooled endpoint (has `-pooler` in the host) — used by the app at runtime.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Unpooled — used by `npm run db:push`, `db:fk` and `db:seed`, which need a
# real session rather than the HTTP pooler.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# ── Neon Auth ────────────────────────────────────────────────────────────────
# From `neonctl neon-auth enable`, or the Auth tab of the Neon console.
NEON_AUTH_BASE_URL=https://ep-xxxx.neonauth.region.aws.neon.tech/neondb/auth
# 32+ characters, or the SDK throws at boot: `openssl rand -hex 32`.
NEON_AUTH_COOKIE_SECRET=

# ── This deploy's identity ────────────────────────────────────────────────────
# Whoever's email this is gets /studio (the admin). Everyone else who signs up
# is a sponsor. This is what makes a deploy "yours" — see CLAUDE.md §3.
CREATOR_EMAIL=you@example.com

# ── Seeded accounts (npm run db:seed) ────────────────────────────────────────
# The admin account seed uses CREATOR_EMAIL above with this password.
ADMIN_PASSWORD=
ADMIN_NAME=Your Name
# A shared demo sponsor, also behind the "Explore the demo account" button on
# /login. Leave DEMO_EMAIL unset and that button is simply not rendered.
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=
DEMO_NAME=Demo Sponsor

# ── GitHub Sponsors (optional — read-only display) ───────────────────────────
# Whose sponsors listing to read on /placements and /studio.
GITHUB_LOGIN=your-github-login
# Classic PAT or fine-grained token with `read:user`. Leave unset and the
# GitHub Sponsors sections don't render at all — they never show fake numbers.
GITHUB_TOKEN=<github-token>

# ── YouTube (optional — subscriber count on the homepage) ─────────────────────
# Same two vars as imswarnil.github.io's Worker — reuse that key if you have it.
# Leave unset and the YouTube tile just says "Connect to show real numbers".
YOUTUBE_API_KEY=<youtube-data-api-key>
YOUTUBE_CHANNEL=<channel-id>

# ── Local dev ────────────────────────────────────────────────────────────────
# This project's own port (see scripts/dev.sh). Not 3000 — that belongs to a
# sibling project under ~/Swarnil.
BASE_URL=http://localhost:3500
