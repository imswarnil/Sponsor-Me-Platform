# ─────────────────────────────────────────────────────────────────────────────
# sponsor.imswarnil.com (SponsorBid) — environment template. Copy to `.env`.
#
# This list is exactly what the code reads. Regenerate it with:
#   grep -rhoE "process\.env\.[A-Z0-9_]+" app lib scripts public | sort -u
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Neon) ──────────────────────────────────────────────────────────
# DATABASE_URL is the POOLED endpoint (`-pooler` in the host) — the app talks to
# it over HTTP. The unpooled one is only for schema work and the seed script,
# which need a real session.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ── Auth (Neon Auth) ─────────────────────────────────────────────────────────
# The cookie secret must be at least 32 characters; createNeonAuth throws
# otherwise. Neon Auth must also be told to TRUST each origin that signs in —
# http://localhost:3500 for dev, and the real hostname in production.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# ── Who the creator is ───────────────────────────────────────────────────────
# NOT OPTIONAL IN PRODUCTION. Unset, admin falls back to the oldest account in
# the database — and that fallback GRANTS ADMIN. See CLAUDE.md §3.
CREATOR_EMAIL=

# ── This deployment's own origin ─────────────────────────────────────────────
# Used for checkout return URLs and as the Origin header the seed script sends.
BASE_URL=http://localhost:3500

# ── Payments (Dodo) ──────────────────────────────────────────────────────────
# Set the TEST key while building. When live is ready set DODO_PAYMENTS_KEY_LIVE
# alongside it and nothing in the code changes — live wins if both are present,
# and the "test mode" notice in the footer disappears on its own.
#
# DODO_PRODUCT_ID is one reusable pay-what-you-want product; create it once with
# `npm run dodo:setup` and paste the id it prints. This app decides every
# amount, not Dodo's catalogue.
#
# DODO_PAYMENTS_WEBHOOK_KEY is REQUIRED for anything to go live: without it the
# webhook cannot verify a signature, so it rejects every delivery and no ad ever
# activates. That is the correct failure, but it is a silent one.
DODO_PAYMENTS_KEY_TEST_MODE=
DODO_PAYMENTS_KEY_LIVE=
DODO_PRODUCT_ID=
DODO_PAYMENTS_WEBHOOK_KEY=

# ── Seeded accounts (`npm run db:seed`) ──────────────────────────────────────
# The creator account is created from CREATOR_EMAIL + ADMIN_PASSWORD.
ADMIN_PASSWORD=
ADMIN_NAME=

# The demo account powers the "Explore the demo account" button on /signin,
# through a server action so the password never enters the browser bundle.
# LEAVE THESE UNSET IN PRODUCTION — the button is an unauthenticated endpoint
# that mints a session, and unset is what stops it rendering at all.
DEMO_EMAIL=
DEMO_PASSWORD=
DEMO_NAME=

# ── Optional ─────────────────────────────────────────────────────────────────
# Overrides the Origin header the seed script sends, if BASE_URL is not the
# origin Neon Auth trusts.
# APP_ORIGIN=
